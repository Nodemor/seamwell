{
  "name": "@seamwell/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "admin:create": "tsx --env-file=.env src/scripts/create-admin.ts",
    "test:e2e": "node --env-file=.env scripts/e2e-smoke.mjs",
    "test:e2e:testdb": "node scripts/test-api-testdb.mjs"
  },
  "dependencies": {
    "@seamwell/shared": "*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
