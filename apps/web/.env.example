# Copy to .env.local  (cp .env.example .env.local)

# Where the Next.js server reaches the Node API (server-side rendering + the /api rewrite).
API_INTERNAL_URL=http://127.0.0.1:4000

# Public site URL (used for metadata / canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Free virtual try-on model (Hugging Face Space). Called from the CUSTOMER'S browser,
# so each customer uses their own free GPU quota. Never put a Hugging Face token here.
NEXT_PUBLIC_TRYON_SPACE=fashn-ai/fashn-vton-1.5
# Backup copies used only while the official Space is busy/stuck (comma-separated). Leave unset for the
# built-in defaults (lib/tryon/spaces.ts), or set it empty to use the official Space only.
# NEXT_PUBLIC_TRYON_BACKUP_SPACES=merve/fashn-vton-1.5,Nymbo/fashn-vton-1.5

# Shop contact details (lib/site.ts) — every phone / WhatsApp / email / map link is built from these.
# Leave unset to show the sample placeholders.
NEXT_PUBLIC_SHOP_PHONE=+94 77 000 0000
NEXT_PUBLIC_SHOP_WHATSAPP=+94 77 000 0000
NEXT_PUBLIC_SHOP_EMAIL=hello@seamwell.example
NEXT_PUBLIC_SHOP_ADDRESS=No. 1, Example Road, Colombo 03
NEXT_PUBLIC_SHOP_MAP_URL=https://maps.google.com/?q=Colombo%2C+Sri+Lanka

# Secret admin address — server-only (never NEXT_PUBLIC_), must equal ADMIN_PATH in apps/api/.env.
# Leave unset in development to keep /admin.
# ADMIN_PATH=
